	(text "22 Ohm on CLK, ESD on all 7 lines, card detect to GPIO0_A4 (JP1.76, 1.8 V) with 100k to VCC_1V8_S3. VDD from\nVCC_3V3_S3 through a 0 Ohm link. JP1.75 (SDMMC_PWREN) is left open: it is GPIO0_A5, the module PMIC's SPI2 clock\n(SPI2_CLK_M2, rk3588-rk806-single.dtsi), D105."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "1d7ad428-e4e9-42d4-b38d-2dc56f223a02")
	)
