	(text "2 x MAX98357A on I2S0 (JP3.69-71, 1.8 V, VIH 1.3 V), supplied from VSYS"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3b8baf08-b899-492e-bbb9-7435e97faa57")
	)
	(text "Maxim MAX98357A/B: SD_MODE high (via 2k) = left channel, 210k (Table 6, 3.3 V) = right, low = shutdown\n(100k internal pull-down). One 3.3 V GPIO (GPIO4_A2, JP2.9) controls both. GAIN_SLOT open = 9 dB. No MCLK needed."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "1f460c3c-1e6e-4a7f-b3a8-b1ff38125c18")
	)
	(text "PDM MEMS microphone (Knowles SPH0641LU4H-1) on PDM0_M0 (GPIO1_C6 / D5, JP1.48 / 49, GPIO_VREF = 3.3 V)"
		(exclude_from_sim no)
		(at 20.32 99.06 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "00e7163e-0143-4434-bd1a-23d66d6a7f43")
	)
	(text "Mic VDD 3.3 V (1.62-3.6 V, VIH 0.7 x VDD) to match the clock level. SEL low = data valid on the clock low phase\n(channel set in the device tree)."
		(exclude_from_sim no)
		(at 20.32 104.14 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "968ac330-3a9c-4a96-8ce8-3ac2ddaa0631")
	)
