	)
	(text "1 GND, 2-3 +5V_KBD, 4 GND, 5 D-, 6 D+, 7 GND, 8 SDA, 9 SCL, 10 INT#, 11 RESET#, 12 BOOT#.\nUSB from hub port 3; I2C6 (3.3 V) to the RP2040 (0x1F, i2c_puppet). INT# on GPIO0_D4 (JP3.81, 1.8 V, can wake the\nSoC): Board B drives it through a BSS138, so the pull-up here sets the level. RESET# / BOOT# open-drain from 3.3 V GPIOs.\n+5V_KBD: TPS2553 on hub PRTPWR3, 0.61-0.74 A limit (2 FFC conductors)."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "fa9d5abc-fd22-4e90-a0ca-6235b556e364")
	)
