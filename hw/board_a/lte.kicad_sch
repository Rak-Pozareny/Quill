		)
		(uuid "f7e8f6ec-3902-46f2-97c2-79346ca31fae")
	)
	(text "Quectel EM060K HD V1.1: USB 2.0 on HOST1 (JP3.1/3 -> pins 7/9) + USB 3.0 on combo PHY2 in USB3 mode (JP2.22/24,\nhost TX -> 100 nF -> pins 37/35; module TX pins 31/29 -> JP2.16/18, caps inside the module). RESET# (VIH max 2.1 V,\ninternal PU to 1.8 V) and W_DISABLE1# driven open-drain by 2N7002s from 3.3 V GPIOs. FULL_CARD_POWER_OFF#\n(>= 1.19 V = on) from GPIO0_C2 at 1.8 V. Unused pins open (Table 5 note)."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "3cb8ee3f-df9c-414a-9a6f-27498f83057a")
