(version 1)
(rule "PTH pad hole to copper (JLC 0.28)" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.28mm)))
(rule "PTH pad hole to inner copper (JLC 0.3)" (layer inner) (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.3mm)))
(rule "NPTH to copper (JLC 0.2)" (condition "A.Pad_Type == 'NPTH, mechanical'") (constraint hole_clearance (min 0.2mm)))
(rule "pad holes (JLC 0.45)" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "USB90 outer" (layer outer) (condition "A.NetClass == 'USB90'") (constraint track_width (min 0.115mm) (opt 0.12mm) (max 0.125mm)) (constraint diff_pair_gap (min 0.09mm) (opt 0.11mm)))
(rule "USB90 inner" (layer inner) (condition "A.NetClass == 'USB90'") (constraint track_width (min 0.095mm) (opt 0.1mm) (max 0.105mm)) (constraint diff_pair_gap (min 0.09mm) (opt 0.11mm)))
(rule "PCIE85 outer" (layer outer) (condition "A.NetClass == 'PCIE85'") (constraint track_width (min 0.125mm) (opt 0.13mm) (max 0.135mm)) (constraint diff_pair_gap (min 0.09mm) (opt 0.1mm)))
(rule "PCIE85 inner" (layer inner) (condition "A.NetClass == 'PCIE85'") (constraint track_width (min 0.105mm) (opt 0.11mm) (max 0.115mm)) (constraint diff_pair_gap (min 0.09mm) (opt 0.1mm)))
(rule "MIPI100 outer" (layer outer) (condition "A.NetClass == 'MIPI100'") (constraint track_width (min 0.105mm) (opt 0.11mm) (max 0.115mm)) (constraint diff_pair_gap (min 0.09mm) (opt 0.155mm)))
(rule "MIPI100 inner" (layer inner) (condition "A.NetClass == 'MIPI100'") (constraint track_width (min 0.095mm) (opt 0.1mm) (max 0.105mm)) (constraint diff_pair_gap (min 0.09mm) (opt 0.2mm)))
(rule "SE50 outer" (layer outer) (condition "A.NetClass == 'SE50'") (constraint track_width (min 0.15mm) (opt 0.155mm) (max 0.16mm)))
(rule "SE50 inner" (layer inner) (condition "A.NetClass == 'SE50'") (constraint track_width (min 0.12mm) (opt 0.125mm) (max 0.13mm)))
(rule "FH35C pass-through (JLC 0.09)" (condition "A.intersectsCourtyard('J704') || A.intersectsCourtyard('J705')") (constraint clearance (min 0.09mm)))
(rule "PCIe AC capacitors beside the Wi-Fi module (D96)" (condition "A.Reference == 'C609' || A.Reference == 'C610' || A.Reference == 'C611' || A.Reference == 'C612' || B.Reference == 'C609' || B.Reference == 'C610' || B.Reference == 'C611' || B.Reference == 'C612'") (constraint courtyard_clearance (min -1mm)))
(rule "CM5_VIN test pad on its pour (D114)" (condition "A.Reference == 'TP204' || B.Reference == 'TP204'") (constraint courtyard_clearance (min -1mm)))
(rule "differential pair internal gap" (condition "A.isCoupledDiffPair()") (constraint clearance (min 0.09mm)))
(rule "USB 2.0 skew" (condition "A.NetClass == 'USB90' && A.inDiffPair('*')") (constraint skew (max 1.27mm) (within_diff_pairs)))
(rule "MIPI skew" (condition "A.NetClass == 'MIPI100' && A.inDiffPair('*')") (constraint skew (max 0.15mm) (within_diff_pairs)))
(rule "PCIe skew" (condition "A.NetClass == 'PCIE85' && A.inDiffPair('*')") (constraint skew (max 0.127mm) (within_diff_pairs)))
(rule "USB 3 skew" (condition "A.NetName == '*USB3_*' && A.inDiffPair('*')") (constraint skew (max 0.127mm) (within_diff_pairs)))
(rule "PCIe reference clock skew" (condition "A.NetName == '*REFCLK*' && A.inDiffPair('*')") (constraint skew (max 0.127mm) (within_diff_pairs)))
(rule "impedance tracks: pour 0.30 mm away on the outer layers (D112)" (layer outer) (condition "A.Type == 'Track' && B.Type == 'Zone' && (A.NetClass == 'MIPI100' || A.NetClass == 'USB90' || A.NetClass == 'PCIE85' || A.NetClass == 'SE50')") (constraint clearance (min 0.3mm)))
