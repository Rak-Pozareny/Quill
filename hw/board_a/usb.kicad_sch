	(text "Common-mode choke + ESD as on the Radxa IO board. CC lines share the ESD array (sink only, VRWM 5.5 V)."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "a8c4b587-3aaf-445a-877f-091c23f8e167")
	)
	(text "USB 2.0 hub USB2514B on CM5 HOST0: P1/P2 USB-A, P3 keyboard, P4 digitizer (reserved)"
		(exclude_from_sim no)
		(at 176.53 25.4 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "dced8f3c-f774-4d60-bfb8-30f65979c678")
	)
	(text "Microchip DS Rev 2.2: CFG_SEL[1:0] = 00 (strap mode, self-powered, individual port power + over-current).\nNON_REM = 00, BC_EN = 0 (internal pull-downs). RBIAS 12.0k 1 %. 24 MHz crystal, 1 MOhm + 18 pF (sec. 7.1).\nVBUS_DET from VCC_3V3_S3 (permanently attached host). RESET_N: GPIO1_B0 (JP1.25, 3.3 V) open-drain + 10k/100 nF.\nUpstream = USB20_HOST0 (JP3.13 / JP3.15)."
		(exclude_from_sim no)
		(at 176.53 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "4689aecf-ce91-4237-9047-f837a8a80604")
	)
	(text "USB-A x2 (bottom edge, mid-mount) with current-limited switches"
		(exclude_from_sim no)
		(at 20.32 161.29 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a18e9dbb-9f8b-4fd2-b4f0-9283744688b9")
	)
	(text "TPS2553 RILIM 39k: IOS min/nom/max 0.61/0.67/0.74 A (TI eq. 1) - covers 500 mA. EN = hub PRTPWRx (active high),\nFAULT# -> OCS_Nx. VBUS bulk 2 x 22 uF per port (USB 2.0 asks 120 uF; reduced for size, accepted at checkpoint 2).\nESD: one TPD4E05U06 per port next to its connector (flow-through, 2 channels used)."
		(exclude_from_sim no)
		(at 20.32 166.37 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "2774e1fa-7e2e-4e48-b455-4a2bc1c3bb6d")
	)
