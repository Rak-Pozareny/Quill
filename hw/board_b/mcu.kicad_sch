	(text "Carrier FFC, 12-pin 0.5 mm (pinout identical to Board A J1001)"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7e67f16e-f446-48af-9125-4689ad2451dc")
	)
	(text "1 GND, 2-3 +5V, 4 GND, 5 D-, 6 D+, 7 GND, 8 SDA, 9 SCL, 10 INT#, 11 RESET#, 12 BOOT#.\nCable type (same-side / opposite-side contacts) chosen at checkpoint 3 so that pin n meets pin n."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "8b83117f-7aad-4a75-b58e-b5585ebb276e")
	)
	(text "3.3 V LDO (as BBQ20KBD)"
		(exclude_from_sim no)
		(at 168.91 25.4 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "442c1c05-b255-472b-95e6-88a177b19626")
	)
	(text "AP2112K-3.3, 600 mA, from the carrier 5 V (current-limited there to 0.61-0.74 A)."
		(exclude_from_sim no)
		(at 168.91 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "9176ed5f-cbdc-44ab-94f0-d4f15867285f")
	)
	(text "RP2040 + 16 Mbit QSPI flash + 12 MHz crystal"
		(exclude_from_sim no)
		(at 287.02 25.4 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8d2ebece-20f7-4c58-83b8-3adaffd52bfa")
	)
	(text "As BBQ20KBD: IOVDD 5 x 100 nF + 1 uF, DVDD 2 x 100 nF + 1 uF, RUN 10k pull-up, QSPI_SS 10k pull-up,\nUSB 27 Ohm series, XOUT 1k series. Crystal ABM8-272-T3 CL 10 pF: C = 2 x (10 - ~3 pF stray) = 15 pF.\nFirmware: i2c_puppet (MIT), board bbq20kbd_breakout - host I2C target 0x1F on GPIO28/29."
		(exclude_from_sim no)
		(at 287.02 30.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "954de947-24b9-4308-9d3a-c06d9ef57063")
	)
	(text "Host I2C / INT / RESET / BOOT isolation (BSS138, gate on the local 3.3 V; INT# open-drain buffer)"
		(exclude_from_sim no)
		(at 20.32 167.64 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "71bf52ba-58e5-47bc-8fab-93800aefc208")
	)
	(text "When Board B is unpowered the FETs are off and their body diodes reverse-biased, so the carrier I2C6 bus\n(touch panel) is not clamped and the RP2040 is not back-powered. Carrier side pull-ups are on Board A.\nINT#: the carrier pulls it up to 1.8 V (wake pin GPIO0_D4), below this side's 3.3 V, where a BSS138's body\ndiode would conduct into it; the open-drain buffer only pulls low and is high-impedance unpowered (D109)."
		(exclude_from_sim no)
		(at 20.32 172.72 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "bbc6dd8b-28fb-48e2-a491-9afc54bf13de")
	)
