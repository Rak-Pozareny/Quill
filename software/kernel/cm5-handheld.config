# Kernel options the CM5 handheld carrier needs on top of Orange Pi's linux-rockchip-rk3588-current.config
# (Linux 6.1, orangepi-build/external/config/kernel/linux-rockchip-rk3588-current.config, which has them unset).
# Built as modules; each loads on its own from the device tree.

# rear camera: Sony IMX214 (Radxa Camera 13M 214) and its DW9714 focus motor
CONFIG_VIDEO_IMX214=m
CONFIG_VIDEO_DW9714=m
# front camera I2C: bit-banged on GPIO1_A0 / A1 (their only I2C function is I2C2, which the module uses)
CONFIG_I2C_GPIO=m
# speakers: 2 x MAX98357A on I2S0; microphone: PDM MEMS on PDM0
CONFIG_SND_SOC_MAX98357A=m
CONFIG_SND_SOC_DMIC=m
# fuel gauge: MAX17055
CONFIG_BATTERY_MAX17042=m
